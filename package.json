    "run-script-os": "^1.1.6"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "hexo-util@2.7.0": true,
    "hexo-util@0.1.7": true,
    "hexo-util@3.3.0": true,
    "hexo-helper-live2d@3.1.1": true,
    "live2d-widget@3.1.4": true
